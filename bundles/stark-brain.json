{
  "schemaVersion": 1,
  "bundle": {
    "name": "stark-brain",
    "version": "0.2.0",
    "description": "Atlas second-brain MCP integration for durable knowledge search, notes, evidence, and ADR workflows.",
    "category": "productivity",
    "tags": [
      "memory",
      "brain",
      "vault",
      "knowledge",
      "capture"
    ],
    "owner": "21 Stark AI",
    "maturity": "beta"
  },
  "artifacts": [
    {
      "name": "brain",
      "type": "mcp",
      "description": "Expose the locally built Atlas brain engine as an MCP server.",
      "version": "0.2.0",
      "runtimes": [
        "claude",
        "codex"
      ],
      "support": {
        "claude": "native",
        "codex": "native"
      },
      "requires": [],
      "diverged": false,
      "outputs": {
        "claude": [
          {
            "path": ".mcp.json",
            "kind": "mergeJSONKey",
            "key": "mcpServers.brain",
            "emulated": false
          }
        ],
        "codex": [
          {
            "path": ".codex/config.toml",
            "kind": "mergeTOMLKey",
            "key": "mcp_servers.brain",
            "emulated": false
          }
        ]
      },
      "fidelityNotes": {}
    }
  ]
}
